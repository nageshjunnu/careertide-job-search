DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/job-search-aggregator
PORT=4000
CLIENT_URL=http://localhost:5173

# SMTP example (Gmail requires an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=CareerTide <your-email@gmail.com>

# Razorpay dashboard → Test Mode → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
# Create a Razorpay monthly ₹1,000 plan, then copy its plan ID here for recurring billing.
RAZORPAY_MONTHLY_PLAN_ID=plan_your_monthly_1000_inr_plan

# Official Naukri OAuth values — supplied only after Naukri approves your partner integration.
# Do not add a candidate's Naukri username or password here.
INTEGRATION_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
NAUKRI_OAUTH_CLIENT_ID=
NAUKRI_OAUTH_CLIENT_SECRET=
NAUKRI_OAUTH_AUTHORIZE_URL=
NAUKRI_OAUTH_TOKEN_URL=
NAUKRI_OAUTH_REDIRECT_URI=https://careertide-job-search.vercel.app/api/integrations/naukri/callback
NAUKRI_OAUTH_SCOPES=

# Optional approved partner integrations (only after each provider grants access).
# Keep these empty until credentials, redirect URLs, and application scopes are approved.
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_AUTHORIZE_URL=https://careertide-job-search.vercel.app/oauth/v2/authorization
LINKEDIN_OAUTH_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_OAUTH_REDIRECT_URI=https://www.linkedin.com/developers/tools/oauth/redirect
LINKEDIN_OAUTH_SCOPES=
FOUNDIT_PARTNER_CLIENT_ID=
FOUNDIT_PARTNER_CLIENT_SECRET=
MONSTER_PARTNER_CLIENT_ID=
MONSTER_PARTNER_CLIENT_SECRET=
SHINE_PARTNER_CLIENT_ID=
SHINE_PARTNER_CLIENT_SECRET=

VITE_API_URL=http://localhost:4000

# Admin console access (choose your own secure credentials)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
